# Copy to .env and fill in. .env is gitignored.

# Keys the pseudonyms that replace student names. Use a long random value and
# keep it private: anyone who has it and your roster can recompute them.
#   python3 -c "import secrets; print(secrets.token_hex(32))"
PII_PSEUDONYM_SECRET=

# CourtListener API token (free account): https://www.courtlistener.com/help/api/rest/
# Case lookups and subsequent-history checks need it.
COURT_LISTENER_API_KEY=

# Optional: Semantic Scholar API key (free, by request) for academic sources.
# Without one the shared public pool is often rate-limited.
SEMANTIC_SCHOLAR_API_KEY=

# Optional: OpenAlex API key, for a daily budget of your own.
OPENALEX_API_KEY=

# Optional: your contact address, sent in the User-Agent to the research APIs.
FIRSTREAD_CONTACT_EMAIL=

# Optional: another folder of assignment packs, looked in before ./packs
# FIRSTREAD_PACKS=~/teaching/packs
